# AutoCommit backend configuration. Copy to backend/.env (or set in the host's secret
# settings) and fill in values. Never commit real values. Every variable here is
# server-side only: none of them may be exposed to the frontend build (no VITE_ prefix).

# --- Vision provider -------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
VISION_PROVIDER=gemini
VISION_MAX_CONCURRENCY=3
VISION_TIMEOUT_SECONDS=120
VISION_MAX_RETRIES=3

# --- Uploads -----------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=20

# --- Database ------------------------------------------------------------------------
# Leave commented out for the local SQLite file backend/data/autocommit.db.
# Supabase/PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# (postgres:// and postgresql:// both use the psycopg driver). The Supabase transaction
# pooler (port 6543) works: server-side prepared statements are disabled.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
# Apply pending migrations at startup. Set false to run `python -m backend.app.db.migrate`
# as a separate release step instead.
DB_AUTO_MIGRATE=true
# PostgreSQL only (ignored for SQLite).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
# disable | allow | prefer | require | verify-ca | verify-full. An sslmode in DATABASE_URL wins.
DB_SSL_MODE=require

# --- Page image storage ----------------------------------------------------------------
# local: files under PAGE_IMAGE_DIR. supabase: private Supabase Storage bucket.
PAGE_IMAGE_STORAGE=local
# Local mode only; defaults to backend/data/pages.
# PAGE_IMAGE_DIR=/var/lib/autocommit/pages
# Required when PAGE_IMAGE_STORAGE=supabase. The bucket must be PRIVATE; the app refuses
# to start with a public bucket. Images are only ever served through the API.
SUPABASE_URL=
# Secret service-role key (Project Settings -> API Keys). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=page-images
STORAGE_TIMEOUT_SECONDS=15
STORAGE_MAX_RETRIES=3
