APP_NAME="AutoCommit Engine"
DEBUG=true
# JSON array of allowed CORS origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:4200"]
MAX_UPLOAD_SIZE_MB=20

# Vision extraction
VISION_PROVIDER=gemini
VISION_MAX_CONCURRENCY=3
VISION_TIMEOUT_SECONDS=120
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Persistence (defaults to backend/data/autocommit.db)
# DATABASE_URL=sqlite:///./backend/data/autocommit.db
